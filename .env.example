# ==============================================================================
# AI STUDY ASSISTANT - VERCEL ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# Add these key-value pairs in your Vercel Project Settings:
# Settings -> Environment Variables -> Add New
#
# Choose Environments: Production, Preview, Development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER-SIDE ENVIRONMENT VARIABLES (Backend / Express / AI)
# ------------------------------------------------------------------------------

# [REQUIRED FOR AI FEATURES] Google Gemini API Key
# Obtain for free from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Alternative fallback variable for Gemini API key
AI_API_KEY=

# [OPTIONAL] Gemini AI Model identifier (Default: gemini-flash-latest)
# Options: gemini-flash-latest, gemini-2.5-flash, gemini-1.5-flash
AI_MODEL=gemini-flash-latest

# [RECOMMENDED] Cryptographic secret for signing session tokens (HMAC-SHA256)
# Generate any secure random string: e.g. openssl rand -hex 32
SESSION_SECRET=ai_study_assistant_firebase_session_secret_2026_change_in_production

# [OPTIONAL / AUTOMATIC ON VERCEL] Node Environment
# Vercel automatically sets NODE_ENV=production during deployment
NODE_ENV=production

# [OPTIONAL / AUTOMATIC ON VERCEL] Server Port
# Default is 3000 if not specified
PORT=3000

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE FIREBASE ENVIRONMENT VARIABLES (Frontend / Vite)
# Note: In Vite, client-exposed variables MUST start with the "VITE_" prefix.
# If these are left blank, the app automatically falls back to firebase-applet-config.json.
# ------------------------------------------------------------------------------

# Firebase Web App API Key
VITE_FIREBASE_API_KEY=AIzaSyBGHBEPbk-5ufxUN6Yv0huca_MJAjx5dzI

# Firebase Auth Domain (e.g., <project-id>.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=hallowed-decker-261jg.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=hallowed-decker-261jg

# Firebase Storage Bucket (e.g., <project-id>.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=hallowed-decker-261jg.firebasestorage.app

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=382907106703

# Firebase Web App ID (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_APP_ID=1:382907106703:web:cf429a7526c27f2b0a77fa

# Cloud Firestore Database ID (CRITICAL for named databases or use '(default)')
VITE_FIREBASE_DATABASE_ID=ai-studio-remixlearnhub-ff26afcc-c996-4c46-8ac1-582d1c0c7ccd
