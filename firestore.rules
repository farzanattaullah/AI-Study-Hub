rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Subcollection: Documents
      match /documents/{documentId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(documentId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Quizzes
      match /quizzes/{quizId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(quizId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Chats
      match /chats/{chatId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(chatId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
